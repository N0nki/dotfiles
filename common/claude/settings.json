{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(less:*)",
      "Bash(more:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(file:*)",
      "Bash(wc:*)",
      "Bash(stat:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.crt)",
      "Read(**/*.cer)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/credentials*)",
      "Read(**/auth*)",
      "Read(**/token*)",
      "Read(.npmrc)",
      "Read(.pypirc)",
      "Read(.netrc)",
      "Read(~/.aws/**)",
      "Read(~/.gcp/**)",
      "Read(~/.azure/**)",
      "Read(~/.ssh/**)",
      "Read(**/*_rsa)",
      "Read(**/*_dsa)",
      "Read(**/*_ecdsa)",
      "Read(**/*_ed25519)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.crt)",
      "Edit(**/*.cer)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/credentials*)",
      "Edit(**/auth*)",
      "Edit(**/token*)",
      "Edit(.npmrc)",
      "Edit(.pypirc)",
      "Edit(.netrc)",
      "Edit(~/.aws/**)",
      "Edit(~/.gcp/**)",
      "Edit(~/.azure/**)",
      "Edit(~/.ssh/**)",
      "Edit(**/*_rsa)",
      "Edit(**/*_dsa)",
      "Edit(**/*_ecdsa)",
      "Edit(**/*_ed25519)",
      "Bash(cat *.env*)",
      "Bash(cat **/.env*)",
      "Bash(head *.env*)",
      "Bash(head **/.env*)",
      "Bash(tail *.env*)",
      "Bash(tail **/.env*)",
      "Bash(less *.env*)",
      "Bash(less **/.env*)",
      "Bash(more *.env*)",
      "Bash(more **/.env*)",
      "Bash(grep *.env*)",
      "Bash(grep **/.env*)",
      "Edit(~/.claude/scripts/aws-profile-*)",
      "Edit(~/dotfiles/common/claude/scripts/aws-profile-*)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*aws.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/aws-profile-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/common/tmux/agent-status.py\" hook claude",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/common/tmux/agent-status.py\" hook claude",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/common/tmux/agent-status.py\" hook claude",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/common/tmux/agent-status.py\" hook claude",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/common/tmux/agent-status.py\" hook claude",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/common/tmux/agent-status.py\" hook claude",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/common/tmux/agent-status.py\" hook claude",
            "timeout": 3
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/common/tmux/agent-status.py\" hook claude",
            "timeout": 3
          }
        ],
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog"
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/common/tmux/agent-status.py\" hook claude",
            "timeout": 3
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/common/tmux/agent-status.py\" hook claude",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/common/tmux/agent-status.py\" hook claude",
            "timeout": 3
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/common/tmux/agent-status.py\" hook claude",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/common/tmux/agent-status.py\" hook claude",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/bin/bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "example-skills@anthropic-agent-skills": true,
    "commit-commands@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "aws-core@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "language": "japanese",
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "vim",
  "preferredNotifChannel": "ghostty",
  "agentPushNotifEnabled": true
}
